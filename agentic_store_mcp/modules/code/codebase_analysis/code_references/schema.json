{
  "name": "code_references",
  "description": "Find local Python and TypeScript/JavaScript symbol imports, definitions, and references with line-level excerpts.",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "Repository or source directory."
      },
      "symbol": {
        "type": "string",
        "description": "Symbol name to locate."
      },
      "extensions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "max_results": {
        "type": "integer",
        "default": 200,
        "maximum": 1000
      }
    },
    "required": [
      "path",
      "symbol"
    ]
  },
  "annotations": {
    "title": "Code References",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
