{
  "name": "data_contract_check",
  "description": "Validate local CSV, JSON, JSONL, or SQLite data against a reusable JSON contract with required columns, uniqueness, nullability, enums, regexes, and numeric ranges.",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string"
      },
      "contract_path": {
        "type": "string",
        "description": "Local JSON contract file."
      },
      "table": {
        "type": "string"
      }
    },
    "required": [
      "path",
      "contract_path"
    ]
  },
  "annotations": {
    "title": "Data Contract Check",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
