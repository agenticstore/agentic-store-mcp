{
  "name": "data_quality_check",
  "description": "Apply read-only quality checks to CSV, JSON, JSONL, or SQLite data: duplicate keys, null thresholds, type drift, invalid emails, and optional referential gaps.",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "Local CSV, JSON, JSONL, or SQLite file."
      },
      "table": {
        "type": "string",
        "description": "SQLite table name."
      },
      "primary_key": {
        "type": "string",
        "description": "Column to check for duplicate non-empty values."
      },
      "max_null_fraction": {
        "type": "number",
        "default": 0.2
      },
      "expected_types": {
        "type": "object",
        "description": "Expected type per column: string, integer, number, or boolean."
      },
      "email_columns": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "reference_path": {
        "type": "string",
        "description": "Optional local reference data source."
      },
      "reference_table": {
        "type": "string",
        "description": "Reference SQLite table name."
      },
      "local_key": {
        "type": "string"
      },
      "reference_key": {
        "type": "string"
      },
      "max_rows": {
        "type": "integer",
        "default": 10000,
        "maximum": 10000
      }
    },
    "required": [
      "path"
    ]
  },
  "annotations": {
    "title": "Data Quality Check",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
